@page "/Models/Version"
@model MatShape.Pages.Models.VersionModel
@{
    ViewData["Title"] = L[Model.IsNew ? "Versions.New" : "Versions.Edit"].Value;
    ViewData["Crumbs"] = new List<(string, string?)>
    {
        (L["Models.Title"].Value, "/Models"), (Model.ModelName, $"/Models/Versions?id={Model.ModelId}"), (Model.IsNew ? L["Common.New"].Value : Model.Name, null),
    };
    ViewData["Width"] = "narrow";
}

@section TopActions {
    @if (!Model.IsNew)
    {
        <a class="mat-btn mat-btn--secondary mat-btn--icon" href="/Models/Studio/@Model.ModelId?version=@Model.Id" aria-label="@L["Versions.Open"]" data-tip="@L["Versions.Open"]">@Ui.Icon("eye")</a>
    }
}

<form class="mat-form" method="post" novalidate>
    <partial name="_FormSummary" model="ViewData.ModelState" />
    <div class="mat-card">
        <div class="mat-card__body mat-form">
            @if (Model.IsNew)
            {
                <div class="mat-alert mat-alert--info" role="note">@Ui.Icon("info")<div>@L["Versions.New.Hint"]</div></div>
            }
            <ms-field name="Name" label="@L["Common.Name"]" required value="@Model.Name" maxlength="120" autofocus msg-required="@L["Common.NameRequired"]" />
            <ms-field name="Description" kind="textarea" label="@L["Models.Description"]" value="@Model.Description" maxlength="1000" rows="3" optional />
        </div>
    </div>
    <div class="mat-btn-row">
        <button type="submit" class="mat-btn mat-btn--primary">@Ui.Icon("save")<span>@L[Model.IsNew ? "Versions.Create" : "Common.Save"]</span></button>
        <a class="mat-btn mat-btn--secondary" href="/Models/Versions?id=@Model.ModelId">@Ui.Icon("back")<span>@L["Common.Back"]</span></a>
        @if (!Model.IsNew)
        {
            <button type="submit" class="mat-btn mat-btn--secondary" formaction="@Url.Page("Version", "Restore", new { modelId = Model.ModelId, id = Model.Id })" formnovalidate
                    data-confirm="@L["Versions.RestoreConfirm", Model.Name]" data-confirm-ok="@L["Versions.Restore"]">@Ui.Icon("restore")<span>@L["Versions.Restore"]</span></button>
            @if (Model.CanDelete)
            {
                <span class="mat-btn-row__spacer"></span>
                <button type="submit" class="mat-btn mat-btn--danger" formaction="@Url.Page("Version", "Delete", new { modelId = Model.ModelId, id = Model.Id })" formnovalidate
                        data-confirm="@L["Versions.DeleteConfirm", Model.Name]" data-confirm-ok="@L["Versions.Delete"]">@Ui.Icon("trash")<span>@L["Versions.Delete"]</span></button>
            }
        }
    </div>
</form>
