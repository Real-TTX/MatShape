@model (long Id, string Active, bool IsOwner)
@*
    The areas of one document (UI rule: an entity with several areas has tabs): General, People and Link belong to the owner, Versions to everybody who sees the document.
    Each tab is a page of its own.
*@
<ms-tabs label="@L["Documents.One"]">
    @if (Model.IsOwner)
    {
        <ms-tab href="/Documents/Edit?id=@Model.Id" active="@(Model.Active == "general")">@L["Documents.Tab.General"]</ms-tab>
        <ms-tab href="/Documents/Members?id=@Model.Id" active="@(Model.Active == "members")">@L["Documents.Tab.Members"]</ms-tab>
        <ms-tab href="/Documents/Share?id=@Model.Id" active="@(Model.Active == "share")">@L["Documents.Tab.Sharing"]</ms-tab>
    }
    <ms-tab href="/Documents/Versions?id=@Model.Id" active="@(Model.Active == "versions")">@L["Documents.Tab.Versions"]</ms-tab>
</ms-tabs>
