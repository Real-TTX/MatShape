@page "/Documents/Share"
@model MatShape.Pages.Documents.ShareModel
@{
    ViewData["Title"] = Model.DocumentName;
    ViewData["PageSub"] = L["Share.Sub"].Value;
    ViewData["Crumbs"] = new List<(string, string?)> { (L["Documents.Title"].Value, "/Documents"), (Model.DocumentName, null) };
    ViewData["Width"] = "narrow";
}

@section TopActions {
    <a class="mat-btn mat-btn--secondary mat-btn--icon" href="/Documents/Studio/@Model.Id" aria-label="@L["Documents.Open"]" data-tip="@L["Documents.Open"]">@Ui.Icon("external")</a>
}

<partial name="_DocumentTabs" model='(Model.Id, "share", true)' />

<form class="mat-form" method="post" novalidate>
    <partial name="_FormSummary" model="ViewData.ModelState" />
    <div class="mat-card">
        <div class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("link")@L["Share.Link"]</h2></div>
        <div class="mat-card__body mat-form">
            <ms-field name="Mode" kind="radios" label="@L["Share.Who"]" value="@Model.Mode" options="Model.Modes" hint="@L["Share.Who.Hint"]" />
            @if (Model.Mode != nameof(LinkMode.Off))
            {
                <div class="mat-field">
                    <label class="mat-label" for="share-url">@L["Share.Address"]</label>
                    <div class="ms-copyrow">
                        <input class="mat-input mat-mono" id="share-url" type="text" readonly value="@Model.LinkUrl" />
                        <button type="button" class="mat-btn mat-btn--secondary" data-copy="#share-url">@Ui.Icon("copy")<span>@L["Common.Copy"]</span></button>
                    </div>
                    <p class="mat-hint">@L["Share.Address.Hint"]</p>
                </div>
            }
        </div>
    </div>
    <div class="mat-btn-row">
        <button type="submit" class="mat-btn mat-btn--primary">@Ui.Icon("save")<span>@L["Common.Save"]</span></button>
        <a class="mat-btn mat-btn--secondary" href="/Documents">@Ui.Icon("back")<span>@L["Common.Back"]</span></a>
        @if (Model.Mode != nameof(LinkMode.Off))
        {
            <span class="mat-btn-row__spacer"></span>
            <button type="submit" class="mat-btn mat-btn--danger" formaction="@Url.Page("Share", "Renew", new { id = Model.Id })" formnovalidate
                    data-confirm="@L["Share.Renew.Confirm"]" data-confirm-ok="@L["Share.Renew"]">@Ui.Icon("refresh")<span>@L["Share.Renew"]</span></button>
        }
    </div>
</form>
