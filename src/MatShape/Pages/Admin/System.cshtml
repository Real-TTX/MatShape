@page "/Admin/System"
@model MatShape.Pages.Admin.SystemModel
@{
    ViewData["Title"] = L["System.Title"].Value;
    ViewData["Crumbs"] = new List<(string, string?)> { (L["Admin.Title"].Value, null), (L["System.Title"].Value, null) };
}

<div class="mat-cols">
    <div class="mat-col-12 mat-col-lg-7">
        <form class="mat-form" method="post" novalidate>
            <partial name="_FormSummary" model="ViewData.ModelState" />
            <div class="mat-card">
                <div class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("settings")@L["System.Settings"]</h2></div>
                <div class="mat-card__body mat-form">
                    <ms-field name="RegistrationOpen" kind="switch" label="@L["System.RegistrationOpen"]" value="@Model.RegistrationOpen.ToString()" hint="@L["System.RegistrationOpen.Hint"]" />
                    <ms-field name="PublicUrl" kind="url" label="@L["System.PublicUrl"]" value="@Model.PublicUrl" placeholder="https://cad.example.com" optional="@(!Model.PublicUrlFixed)" disabled="@Model.PublicUrlFixed" hint="@L[Model.PublicUrlFixed ? "System.PublicUrl.Fixed" : "System.PublicUrl.Hint"]" />
                </div>
            </div>
            <ms-buttons save="@L["Common.Save"]" back="/Documents" />
        </form>
    </div>
    <div class="mat-col-12 mat-col-lg-5">
        <div class="mat-card">
            <div class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("info")@L["System.About"]</h2></div>
            <div class="mat-card__body">
                <dl class="ms-dl">
                    <dt>@L["System.Version"]</dt><dd class="mat-mono">@AppInfo.Version</dd>
                    <dt>@L["System.Database"]</dt><dd class="mat-mono">@Model.Database</dd>
                    <dt>@L["Users.Title"]</dt><dd>@Model.Counts.Users</dd>
                    <dt>@L["Documents.Title"]</dt><dd>@Model.Counts.Documents</dd>
                    <dt>@L["System.SharedDocuments"]</dt><dd>@Model.Counts.SharedDocuments</dd>
                    <dt>@L["System.LinkedDocuments"]</dt><dd>@Model.Counts.LinkedDocuments</dd>
                    <dt>@L["System.Studios"]</dt><dd>@Model.Counts.Studios</dd>
                    <dt>@L["System.Versions"]</dt><dd>@Model.Counts.Versions</dd>
                    <dt>@L["System.Mail"]</dt><dd>@(Model.MailText ?? L["System.Mail.Off"].Value)</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
