@model StudioViewModel
@inject CurrentUser Me
@*
    The editor of a model: the bar (back, name, state, undo/redo, versions, export, theme), the feature tools (or the sketch tools while a sketch is edited),
    the feature list with the parts on the left, the 3D view in the middle with its view buttons and the dialog of the feature being edited, the tabs of the Part Studios
    at the foot. Everything that depends on the model is drawn by the scripts (js/cad/*.js) from /live/models/{id}; this markup is the frame and the texts.
*@
@{
    var user = Me.Snapshot;
    var canEdit = Model.CanEdit;
    var back = Model.LinkToken is not null && user is null ? "/" : Model.FolderId is { } folder ? $"/Models?folder={folder}" : "/Models";
}
<div class="ms-studio" id="ms-studio"
     data-model="@Model.ModelId"
     data-token="@(Model.LinkToken ?? string.Empty)"
     data-version="@(Model.VersionId?.ToString() ?? string.Empty)"
     data-can-edit="@(canEdit ? "true" : "false")"
     data-owner="@(Model.IsOwner ? "true" : "false")"
     data-person="@Model.PersonName"
     data-signed-in="@(user is null ? "false" : "true")">

    <header class="ms-bar">
        <a class="ms-bar__home" href="@back" aria-label="@L["Studio.Back"]" data-tip="@L["Studio.Back"]" data-tip-place="below" data-tip-align="start">@Ui.Logo("sm")</a>
        <div class="ms-bar__title">
            <h1 class="ms-bar__name" data-doc-name>@Model.Name</h1>
            <span class="ms-bar__meta">
                @if (Model.VersionId is not null)
                {
                    <span class="mat-pill mat-pill--warn" data-version-pill>@Ui.Icon("version")<span data-version-name>@L["Studio.Version"]</span></span>
                }
                else if (!canEdit)
                {
                    <span class="mat-pill mat-pill--plain">@Ui.Icon("eye")<span>@L["Studio.ReadOnly"]</span></span>
                }
                <span class="ms-save" data-save-state aria-live="polite"></span>
            </span>
        </div>
        <div class="ms-bar__actions">
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon ms-offline-btn" data-offline hidden aria-label="@L["Studio.Offline"]" data-tip="@L["Studio.Offline"]" data-tip-place="below" data-tip-align="end">@Ui.Icon("cloud-off")</button>
            @if (canEdit)
            {
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon" data-action="undo" disabled aria-label="@L["Studio.Undo"]" data-tip="@L["Studio.Undo"] (Ctrl+Z)" data-tip-place="below" data-tip-align="end">@Ui.Icon("undo")</button>
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon" data-action="redo" disabled aria-label="@L["Studio.Redo"]" data-tip="@L["Studio.Redo"] (Ctrl+Y)" data-tip-place="below" data-tip-align="end">@Ui.Icon("redo")</button>
                <span class="ms-bar__sep" aria-hidden="true"></span>
                @if (Model.ShowAi)
                {
                    <button type="button" class="mat-btn mat-btn--ghost ms-ai-btn" data-action="ai" aria-label="@L["Studio.Ai.Title"]" data-tip="@L["Studio.Ai.Title"]" data-tip-place="below" data-tip-align="end">@Ui.Icon("sparkles")<span class="ms-hide-xs">@L["Studio.Ai.Short"]</span></button>
                }
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon" data-action="version" aria-label="@L["Studio.CreateVersion"]" data-tip="@L["Studio.CreateVersion"]" data-tip-place="below" data-tip-align="end">@Ui.Icon("version")</button>
            }
            @if (Model.LinkToken is null)
            {
                <a class="mat-btn mat-btn--ghost mat-btn--icon ms-hide-xs" href="/Models/Versions?id=@Model.ModelId" aria-label="@L["Versions.Title"]" data-tip="@L["Versions.Title"]" data-tip-place="below" data-tip-align="end">@Ui.Icon("history")</a>
            }
            @if (Model.IsOwner)
            {
                <a class="mat-btn mat-btn--ghost mat-btn--icon ms-hide-xs" href="/Models/Members?id=@Model.ModelId" aria-label="@L["Studio.Share"]" data-tip="@L["Studio.Share"]" data-tip-place="below" data-tip-align="end">@Ui.Icon("share")</a>
            }
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon ms-hide-xs" data-action="keys" aria-label="@L["Keys.Title"]" data-tip="@L["Keys.Title"] (?)" data-tip-place="below" data-tip-align="end">@Ui.Icon("help-circle")</button>
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon" data-menu-toggle="ms-export-menu" aria-haspopup="menu" aria-expanded="false" aria-label="@L["Studio.Export"]" data-tip="@L["Studio.Export"]" data-tip-place="below" data-tip-align="end">@Ui.Icon("download")</button>
            <button type="button" class="mat-theme ms-bar__theme" data-theme-toggle data-theme-state="@(user?.Theme ?? "system")" @(user is null ? "" : "data-theme-save-url=/Account?handler=Theme") aria-label="@L["Shell.Theme"]" title="@L["Shell.Theme"]">
                <svg class="mat-icon" data-theme-icon="system" aria-hidden="true" focusable="false"><use href="#mat-i-monitor"></use></svg>
                <svg class="mat-icon" data-theme-icon="light" aria-hidden="true" focusable="false"><use href="#mat-i-sun"></use></svg>
                <svg class="mat-icon" data-theme-icon="dark" aria-hidden="true" focusable="false"><use href="#mat-i-moon"></use></svg>
            </button>
        </div>
    </header>

    <div class="mat-menu" id="ms-export-menu" role="menu" aria-label="@L["Studio.Export"]" hidden>
        <button type="button" class="mat-menu__item" role="menuitem" data-export="stl">@Ui.Icon("download")<span>@L["Studio.Export.Stl"]</span></button>
        <button type="button" class="mat-menu__item" role="menuitem" data-export="3mf">@Ui.Icon("download")<span>@L["Studio.Export.ThreeMf"]</span></button>
        <button type="button" class="mat-menu__item" role="menuitem" data-export="step">@Ui.Icon("download")<span>@L["Studio.Export.Step"]</span></button>
        <button type="button" class="mat-menu__item" role="menuitem" data-export="obj">@Ui.Icon("download")<span>@L["Studio.Export.Obj"]</span></button>
        <button type="button" class="mat-menu__item" role="menuitem" data-export="png">@Ui.Icon("image")<span>@L["Studio.Export.Png"]</span></button>
        <button type="button" class="mat-menu__item" role="menuitem" data-export="drawing">@Ui.Icon("drawing")<span>@L["Studio.Export.Drawing"]</span></button>
        <div class="mat-menu__sep" role="separator"></div>
        <button type="button" class="mat-menu__item" role="menuitem" data-export="json">@Ui.Icon("code")<span>@L["Studio.Export.Json"]</span></button>
    </div>

    @* the feature tools (OnShape-like: a row of tools over the work area); hidden while a sketch is edited *@
    <div class="ms-tools ms-tools--icons" role="toolbar" aria-label="@L["Studio.Tools"]" data-toolbar="features">
        @if (canEdit)
        {
            <button type="button" class="ms-tool" data-feature="sketch" data-tip="@L["Feature.sketch"] (Shift+S)">@Ui.Icon("sketch")<span>@L["Feature.sketch"]</span></button>
            <span class="ms-tools__sep" aria-hidden="true"></span>
            <button type="button" class="ms-tool" data-feature="extrude" data-tip="@L["Feature.extrude"] (Shift+E)">@Ui.Icon("extrude")<span>@L["Feature.extrude"]</span></button>
            <button type="button" class="ms-tool" data-feature="revolve" data-tip="@L["Feature.revolve"] (Shift+W)">@Ui.Icon("revolve")<span>@L["Feature.revolve"]</span></button>
            <button type="button" class="ms-tool" data-feature="sweep" data-tip="@L["Feature.sweep"]">@Ui.Icon("sweep")<span>@L["Feature.sweep"]</span></button>
            <button type="button" class="ms-tool" data-feature="loft" data-tip="@L["Feature.loft"]">@Ui.Icon("loft")<span>@L["Feature.loft"]</span></button>
            <span class="ms-tools__sep" aria-hidden="true"></span>
            <button type="button" class="ms-tool" data-feature="fillet" data-tip="@L["Feature.fillet"] (Shift+F)">@Ui.Icon("fillet")<span>@L["Feature.fillet"]</span></button>
            <button type="button" class="ms-tool" data-feature="chamfer" data-tip="@L["Feature.chamfer"]">@Ui.Icon("chamfer")<span>@L["Feature.chamfer"]</span></button>
            <button type="button" class="ms-tool" data-feature="hole" data-tip="@L["Feature.hole"]">@Ui.Icon("hole")<span>@L["Feature.hole"]</span></button>
            <button type="button" class="ms-tool" data-feature="shell" data-tip="@L["Feature.shell"]">@Ui.Icon("shell")<span>@L["Feature.shell"]</span></button>
            <button type="button" class="ms-tool" data-feature="rib" data-tip="@L["Feature.rib"]">@Ui.Icon("rib")<span>@L["Feature.rib"]</span></button>
            <button type="button" class="ms-tool" data-feature="draft" data-tip="@L["Feature.draft"]">@Ui.Icon("draft")<span>@L["Feature.draft"]</span></button>
            <button type="button" class="ms-tool" data-feature="thread" data-tip="@L["Feature.thread"]">@Ui.Icon("thread")<span>@L["Feature.thread"]</span></button>
            <button type="button" class="ms-tool" data-feature="figure" data-tip="@L["Feature.figure"]">@Ui.Icon("figure")<span>@L["Feature.figure"]</span></button>
            <span class="ms-tools__sep" aria-hidden="true"></span>
            <button type="button" class="ms-tool" data-feature="boolean" data-tip="@L["Feature.boolean"]">@Ui.Icon("boolean")<span>@L["Feature.boolean"]</span></button>
            <button type="button" class="ms-tool" data-feature="split" data-tip="@L["Feature.split"]">@Ui.Icon("split")<span>@L["Feature.split"]</span></button>
            <button type="button" class="ms-tool" data-feature="transform" data-tip="@L["Feature.transform"]">@Ui.Icon("move")<span>@L["Feature.transform"]</span></button>
            <button type="button" class="ms-tool" data-feature="mirror" data-tip="@L["Feature.mirror"]">@Ui.Icon("mirror")<span>@L["Feature.mirror"]</span></button>
            <button type="button" class="ms-tool" data-feature="lpattern" data-tip="@L["Feature.lpattern"]">@Ui.Icon("pattern-linear")<span>@L["Feature.lpattern"]</span></button>
            <button type="button" class="ms-tool" data-feature="cpattern" data-tip="@L["Feature.cpattern"]">@Ui.Icon("pattern-circular")<span>@L["Feature.cpattern"]</span></button>
            <button type="button" class="ms-tool" data-feature="deletepart" data-tip="@L["Feature.deletepart"]">@Ui.Icon("delete-part")<span>@L["Feature.deletepart"]</span></button>
            <span class="ms-tools__sep" aria-hidden="true"></span>
            <button type="button" class="ms-tool" data-feature="plane" data-tip="@L["Feature.plane"]">@Ui.Icon("plane")<span>@L["Feature.plane"]</span></button>
            <button type="button" class="ms-tool" data-feature="variable" data-tip="@L["Feature.variable"]">@Ui.Icon("variable")<span>@L["Feature.variable"]</span></button>
            <button type="button" class="ms-tool" data-action="image" data-tip="@L["Image.Tool"]">@Ui.Icon("image")<span>@L["Image.Short"]</span></button>
            @if (Model.ShowAi3d)
            {
                <button type="button" class="ms-tool" data-action="mesh" data-tip="@L["Studio.Mesh.Tool"]">@Ui.Icon("ai-3d")<span>@L["Studio.Mesh.Short"]</span></button>
            }
            <button type="button" class="ms-tool" data-action="import" data-tip="@L["Import.Tool"]">@Ui.Icon("upload")<span>@L["Import.Short"]</span></button>
            <span class="ms-tools__sep" aria-hidden="true"></span>
        }
        <button type="button" class="ms-tool" data-action="measure" aria-pressed="false" data-tip="@L["Studio.Measure"] (M)">@Ui.Icon("ruler")<span>@L["Studio.Measure"]</span></button>
        <button type="button" class="ms-tool" data-action="drawing" data-tip="@L["Drawing.Tool"]">@Ui.Icon("drawing")<span>@L["Drawing.Short"]</span></button>
    </div>

    @* the sketch tools, shown while a sketch is edited *@
    <div class="ms-tools ms-tools--sketch ms-tools--icons" role="toolbar" aria-label="@L["Sketch.Tools"]" data-toolbar="sketch" hidden>
        <button type="button" class="ms-tool" data-sketch-tool="select" aria-pressed="true" data-tip="@L["Sketch.Select"] (Esc)">@Ui.Icon("cursor")<span>@L["Sketch.Select"]</span></button>
        <span class="ms-tools__sep" aria-hidden="true"></span>
        <button type="button" class="ms-tool" data-sketch-tool="line" aria-pressed="false" data-tip="@L["Sketch.Line"] (L)">@Ui.Icon("line")<span>@L["Sketch.Line"]</span></button>
        <button type="button" class="ms-tool" data-sketch-tool="spline" aria-pressed="false" data-tip="@L["Sketch.Spline.Tip"]">@Ui.Icon("spline")<span>@L["Sketch.Spline"]</span></button>
        <button type="button" class="ms-tool" data-sketch-tool="rect" aria-pressed="false" data-tip="@L["Sketch.Rect"] (G)">@Ui.Icon("rectangle")<span>@L["Sketch.Rect"]</span></button>
        <button type="button" class="ms-tool" data-sketch-tool="crect" aria-pressed="false" data-tip="@L["Sketch.CenterRect"]">@Ui.Icon("rectangle-center")<span>@L["Sketch.CenterRect"]</span></button>
        <button type="button" class="ms-tool" data-sketch-tool="circle" aria-pressed="false" data-tip="@L["Sketch.Circle"] (C)">@Ui.Icon("circle-tool")<span>@L["Sketch.Circle"]</span></button>
        <button type="button" class="ms-tool" data-sketch-tool="ellipse" aria-pressed="false" data-tip="@L["Sketch.Ellipse.Tip"]">@Ui.Icon("ellipse")<span>@L["Sketch.Ellipse"]</span></button>
        <button type="button" class="ms-tool" data-sketch-tool="arc" aria-pressed="false" data-tip="@L["Sketch.Arc"] (A)">@Ui.Icon("arc")<span>@L["Sketch.Arc"]</span></button>
        <button type="button" class="ms-tool" data-sketch-tool="tarc" aria-pressed="false" data-tip="@L["Sketch.TangentArc.Tip"] (T)">@Ui.Icon("tangent-arc")<span>@L["Sketch.TangentArc"]</span></button>
        <button type="button" class="ms-tool" data-sketch-tool="polygon" aria-pressed="false" data-tip="@L["Sketch.Polygon"]">@Ui.Icon("polygon")<span>@L["Sketch.Polygon"]</span></button>
        <button type="button" class="ms-tool" data-sketch-tool="slot" aria-pressed="false" data-tip="@L["Sketch.Slot.Tip"]">@Ui.Icon("slot")<span>@L["Sketch.Slot"]</span></button>
        <button type="button" class="ms-tool" data-sketch-tool="point" aria-pressed="false" data-tip="@L["Sketch.Point"]">@Ui.Icon("point")<span>@L["Sketch.Point"]</span></button>
        <button type="button" class="ms-tool" data-sketch-tool="text" aria-pressed="false" data-tip="@L["Sketch.Text.Tip"]">@Ui.Icon("text")<span>@L["Sketch.Text"]</span></button>
        <span class="ms-tools__sep" aria-hidden="true"></span>
        <button type="button" class="ms-tool" data-sketch-tool="sfillet" aria-pressed="false" data-tip="@L["Sketch.SketchFillet.Tip"]">@Ui.Icon("fillet")<span>@L["Sketch.SketchFillet"]</span></button>
        <button type="button" class="ms-tool" data-sketch-tool="trim" aria-pressed="false" data-tip="@L["Sketch.Trim.Tip"] (M)">@Ui.Icon("trim")<span>@L["Sketch.Trim"]</span></button>
        <button type="button" class="ms-tool" data-sketch-tool="offset" aria-pressed="false" data-tip="@L["Sketch.Offset.Tip"] (O)">@Ui.Icon("offset")<span>@L["Sketch.Offset"]</span></button>
        <button type="button" class="ms-tool" data-sketch-tool="mirror" aria-pressed="false" data-tip="@L["Sketch.Mirror.Tip"]">@Ui.Icon("mirror")<span>@L["Sketch.Mirror"]</span></button>
        <span class="ms-tools__sep" aria-hidden="true"></span>
        <button type="button" class="ms-tool" data-sketch-tool="use" aria-pressed="false" data-tip="@L["Sketch.Use.Tip"] (U)">@Ui.Icon("use-edge")<span>@L["Sketch.Use"]</span></button>
        <button type="button" class="ms-tool" data-sketch-action="slice" data-tip="@L["Sketch.Slice.Tip"]">@Ui.Icon("slice")<span>@L["Sketch.Slice"]</span></button>
        <button type="button" class="ms-tool" data-sketch-action="outline" data-tip="@L["Sketch.Outline.Tip"]">@Ui.Icon("outline")<span>@L["Sketch.Outline"]</span></button>
        <button type="button" class="ms-tool" data-sketch-action="image" data-tip="@L["Sketch.Image.Tip"]">@Ui.Icon("image")<span>@L["Sketch.Image"]</span></button>
        <span class="ms-tools__sep" aria-hidden="true"></span>
        <button type="button" class="ms-tool" data-sketch-tool="dimension" aria-pressed="false" data-tip="@L["Sketch.Dimension"] (D)">@Ui.Icon("dimension")<span>@L["Sketch.Dimension"]</span></button>
        <span class="ms-tools__sep" aria-hidden="true"></span>
        <button type="button" class="ms-tool" data-sketch-constraint="coincident" aria-pressed="false" data-tip="@L["Sketch.Coincident"] (I)">@Ui.Icon("coincident")<span>@L["Sketch.Coincident"]</span></button>
        <button type="button" class="ms-tool" data-sketch-constraint="horizontal" aria-pressed="false" data-tip="@L["Sketch.Horizontal"] (H)">@Ui.Icon("horizontal")<span>@L["Sketch.Horizontal"]</span></button>
        <button type="button" class="ms-tool" data-sketch-constraint="vertical" aria-pressed="false" data-tip="@L["Sketch.Vertical"] (V)">@Ui.Icon("vertical")<span>@L["Sketch.Vertical"]</span></button>
        <button type="button" class="ms-tool" data-sketch-constraint="parallel" aria-pressed="false" data-tip="@L["Sketch.Parallel"]">@Ui.Icon("parallel")<span>@L["Sketch.Parallel"]</span></button>
        <button type="button" class="ms-tool" data-sketch-constraint="perpendicular" aria-pressed="false" data-tip="@L["Sketch.Perpendicular"]">@Ui.Icon("perpendicular")<span>@L["Sketch.Perpendicular"]</span></button>
        <button type="button" class="ms-tool" data-sketch-constraint="tangent" aria-pressed="false" data-tip="@L["Sketch.Tangent"]">@Ui.Icon("tangent")<span>@L["Sketch.Tangent"]</span></button>
        <button type="button" class="ms-tool" data-sketch-constraint="equal" aria-pressed="false" data-tip="@L["Sketch.Equal"]">@Ui.Icon("equal")<span>@L["Sketch.Equal"]</span></button>
        <button type="button" class="ms-tool" data-sketch-constraint="midpoint" aria-pressed="false" data-tip="@L["Sketch.Midpoint"]">@Ui.Icon("midpoint")<span>@L["Sketch.Midpoint"]</span></button>
        <button type="button" class="ms-tool" data-sketch-constraint="concentric" aria-pressed="false" data-tip="@L["Sketch.Concentric"]">@Ui.Icon("concentric")<span>@L["Sketch.Concentric"]</span></button>
        <button type="button" class="ms-tool" data-sketch-constraint="symmetric" aria-pressed="false" data-tip="@L["Sketch.Symmetric.Tip"]">@Ui.Icon("symmetric")<span>@L["Sketch.Symmetric"]</span></button>
        <button type="button" class="ms-tool" data-sketch-constraint="fix" aria-pressed="false" data-tip="@L["Sketch.Fix"]">@Ui.Icon("fix")<span>@L["Sketch.Fix"]</span></button>
        <span class="ms-tools__sep" aria-hidden="true"></span>
        <button type="button" class="ms-tool" data-sketch-action="construction" aria-pressed="false" data-tip="@L["Sketch.Construction"] (Q)">@Ui.Icon("construction")<span>@L["Sketch.Construction"]</span></button>
        <button type="button" class="ms-tool" data-sketch-action="delete" data-tip="@L["Sketch.DeleteSelected"] (Del)">@Ui.Icon("trash")<span>@L["Sketch.DeleteSelected"]</span></button>
        <button type="button" class="ms-tool" data-sketch-action="normal" data-tip="@L["Sketch.NormalTo"] (N)">@Ui.Icon("normal-to")<span>@L["Sketch.NormalTo"]</span></button>
        <span class="ms-tools__grow" aria-hidden="true"></span>
        <button type="button" class="ms-tool ms-tool--accept" data-sketch-action="finish" data-tip="@L["Sketch.Finish"] (Enter)">@Ui.Icon("check")<span>@L["Sketch.Finish"]</span></button>
    </div>

    @* the tools of a drawing tab *@
    <div class="ms-tools ms-tools--drawing" role="toolbar" aria-label="@L["Drawing.Tools"]" data-toolbar="drawing" hidden>
        <button type="button" class="ms-tool" data-draw-tool="select" aria-pressed="true" data-tip="@L["Drawing.Tool.Select"]">@Ui.Icon("cursor")<span>@L["Drawing.Tool.Select"]</span></button>
        <span class="ms-tools__sep" aria-hidden="true"></span>
        <button type="button" class="ms-tool" data-draw-tool="dim" aria-pressed="false" data-tip="@L["Drawing.Tool.Dim"]">@Ui.Icon("dimension")<span>@L["Drawing.Tool.Dim"]</span></button>
        <button type="button" class="ms-tool" data-draw-tool="dia" aria-pressed="false" data-tip="@L["Drawing.Tool.Dia"]">@Ui.Icon("circle-tool")<span>@L["Drawing.Tool.Dia"]</span></button>
        <button type="button" class="ms-tool" data-draw-tool="detail" aria-pressed="false" data-tip="@L["Drawing.Tool.Detail"]">@Ui.Icon("search")<span>@L["Drawing.Tool.Detail"]</span></button>
        <button type="button" class="ms-tool" data-draw-action="delete" data-tip="@L["Drawing.Tool.Delete"] (Del)">@Ui.Icon("trash")<span>@L["Drawing.Tool.Delete"]</span></button>
        <span class="ms-tools__sep" aria-hidden="true"></span>
        <button type="button" class="ms-tool" data-draw-action="fit" data-tip="@L["View.Fit"]">@Ui.Icon("zoom-fit")<span>@L["View.Fit"]</span></button>
        <span class="ms-tools__grow" aria-hidden="true"></span>
        <button type="button" class="ms-tool" data-draw-action="pdf" data-tip="PDF">@Ui.Icon("download")<span>PDF</span></button>
        <button type="button" class="ms-tool" data-draw-action="svg" data-tip="SVG">@Ui.Icon("download")<span>SVG</span></button>
        <button type="button" class="ms-tool" data-draw-action="dxf" data-tip="DXF">@Ui.Icon("download")<span>DXF</span></button>
    </div>

    @* the tools of an assembly tab *@
    <div class="ms-tools ms-tools--assembly" role="toolbar" aria-label="@L["Asm.Tools"]" data-toolbar="assembly" hidden>
        <button type="button" class="ms-tool" data-asm-action="insert" data-tip="@L["Asm.Insert.Tip"]">@Ui.Icon("plus")<span>@L["Asm.Insert"]</span></button>
        <span class="ms-tools__sep" aria-hidden="true"></span>
        <button type="button" class="ms-tool" data-asm-mate="fastened" aria-pressed="false" data-tip="@L["Asm.Mate.Fastened.Tip"]">@Ui.Icon("mate-fastened")<span>@L["Asm.Mate.Fastened"]</span></button>
        <button type="button" class="ms-tool" data-asm-mate="revolute" aria-pressed="false" data-tip="@L["Asm.Mate.Revolute.Tip"]">@Ui.Icon("mate-revolute")<span>@L["Asm.Mate.Revolute"]</span></button>
        <button type="button" class="ms-tool" data-asm-mate="slider" aria-pressed="false" data-tip="@L["Asm.Mate.Slider.Tip"]">@Ui.Icon("mate-slider")<span>@L["Asm.Mate.Slider"]</span></button>
        <button type="button" class="ms-tool" data-asm-mate="cylindrical" aria-pressed="false" data-tip="@L["Asm.Mate.Cylindrical.Tip"]">@Ui.Icon("mate-cylindrical")<span>@L["Asm.Mate.Cylindrical"]</span></button>
        <button type="button" class="ms-tool" data-asm-mate="planar" aria-pressed="false" data-tip="@L["Asm.Mate.Planar.Tip"]">@Ui.Icon("mate-planar")<span>@L["Asm.Mate.Planar"]</span></button>
        <span class="ms-tools__sep" aria-hidden="true"></span>
        <label class="ms-tool ms-tool--range" data-tip="@L["Asm.Explode.Tip"]">@Ui.Icon("assembly")<span>@L["Asm.Explode"]</span><input type="range" min="0" max="100" value="0" data-asm-explode aria-label="@L["Asm.Explode"]"></label>
        <button type="button" class="ms-tool" data-asm-action="interference" data-tip="@L["Asm.Interference.Tip"]">@Ui.Icon("alert")<span>@L["Asm.Interference"]</span></button>
        <button type="button" class="ms-tool" data-asm-action="bom" data-tip="@L["Asm.Bom.Tip"]">@Ui.Icon("list")<span>@L["Asm.Bom"]</span></button>
    </div>

    <div class="ms-work">
        <aside class="ms-side" id="ms-side" aria-label="@L["Studio.FeatureList"]">
            <section class="ms-side__part">
                <h2 class="ms-side__head">@Ui.Icon("list")<span>@L["Studio.Features"]</span><span class="ms-side__count" data-feature-count></span></h2>
                <ol class="ms-tree" data-feature-list aria-label="@L["Studio.FeatureList"]"></ol>
            </section>
            <section class="ms-side__part" data-parts-section>
                <h2 class="ms-side__head">@Ui.Icon("part")<span>@L["Studio.Parts"]</span><span class="ms-side__count" data-part-count></span></h2>
                <ul class="ms-parts" data-part-list aria-label="@L["Studio.Parts"]"></ul>
            </section>
            <section class="ms-side__part" data-drawing-panel hidden></section>
            <section class="ms-side__part ms-asmpanel" data-assembly-panel hidden></section>
        </aside>
        <button type="button" class="ms-side-toggle mat-btn mat-btn--secondary mat-btn--icon" data-action="side" aria-controls="ms-side" aria-expanded="true" aria-label="@L["Studio.FeatureList"]">@Ui.Icon("sidebar")</button>

        <div class="ms-view" data-view>
            <canvas class="ms-canvas" data-canvas tabindex="0" aria-label="@L["Studio.Viewport"]"></canvas>
            <div class="ms-sheet" data-sheet hidden></div>

            @* the view cube (OnShape-like): turns with the view; a click on a face, an edge or a corner turns the view there, a drag turns the model *@
            <div class="ms-cube">
                <canvas class="ms-cube__canvas" data-viewcube role="img" aria-label="@L["View.Cube"]" title="@L["View.Cube.Hint"]"></canvas>
                <button type="button" class="ms-cube__roll ms-cube__roll--left" data-roll="90" aria-label="@L["View.RollLeft"]" data-tip="@L["View.RollLeft"]" data-tip-place="below" data-tip-align="end">@Ui.Icon("rotate-ccw")</button>
                <button type="button" class="ms-cube__roll ms-cube__roll--right" data-roll="-90" aria-label="@L["View.RollRight"]" data-tip="@L["View.RollRight"]" data-tip-place="below" data-tip-align="end">@Ui.Icon("rotate-cw")</button>
            </div>

            <div class="ms-viewtools" role="toolbar" aria-label="@L["Studio.Views"]">
                <button type="button" class="ms-vbtn" data-view-set="iso" aria-label="@L["View.Iso"]" data-tip="@L["View.Iso"] (Shift+7)" data-tip-align="end">@Ui.Icon("view-iso")</button>
                <button type="button" class="ms-vbtn" data-action="fit" aria-label="@L["View.Fit"]" data-tip="@L["View.Fit"] (F)" data-tip-align="end">@Ui.Icon("zoom-fit")</button>
                <span class="ms-viewtools__sep" aria-hidden="true"></span>
                <button type="button" class="ms-vbtn" data-action="display" aria-label="@L["View.Display"]" data-tip="@L["View.Display"]" data-tip-align="end">@Ui.Icon("shaded")</button>
                <button type="button" class="ms-vbtn" data-menu-toggle="ms-theme-menu" aria-haspopup="menu" aria-expanded="false" aria-label="@L["View.Theme"]" data-tip="@L["View.Theme"]" data-tip-align="end">@Ui.Icon("palette")</button>
                <button type="button" class="ms-vbtn" data-action="planes" aria-pressed="true" aria-label="@L["View.Planes"]" data-tip="@L["View.Planes"] (P)" data-tip-align="end">@Ui.Icon("plane")</button>
                <button type="button" class="ms-vbtn" data-action="section" aria-pressed="false" aria-label="@L["View.Section"]" data-tip="@L["View.Section"]" data-tip-align="end">@Ui.Icon("section")</button>
                @* the 3D mouse: only where the browser can talk to it (WebHID: Chrome, Edge); app.js shows it *@
                <button type="button" class="ms-vbtn" data-action="spacemouse" data-menu-toggle="ms-spacemouse-menu" aria-haspopup="menu" aria-expanded="false" aria-pressed="false" hidden
                        aria-label="@L["View.SpaceMouse"]" data-tip="@L["View.SpaceMouse"]" data-tip-align="end">@Ui.Icon("spacemouse")</button>
            </div>

            @* the section view: the parts cut by a plane that can be moved (the cut faces hatched) *@
            <div class="ms-section" data-section-panel role="group" aria-label="@L["View.Section"]" hidden>
                <span class="ms-section__title">@Ui.Icon("section")<span>@L["View.Section"]</span></span>
                <select class="mat-select mat-select--sm mat-input--sm" data-section-plane aria-label="@L["View.Section.Plane"]"></select>
                <input type="range" class="ms-section__range" data-section-offset min="-100" max="100" step="0.1" value="0" aria-label="@L["View.Section.Offset"]">
                <input class="mat-input mat-input--sm mat-mono ms-section__value" data-section-value inputmode="decimal" autocomplete="off" aria-label="@L["View.Section.Offset"]">
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-section-flip aria-pressed="false" aria-label="@L["View.Section.Flip"]" data-tip="@L["View.Section.Flip"]">@Ui.Icon("flip")</button>
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-section-close aria-label="@L["Common.Dialog.Close"]" data-tip="@L["Common.Dialog.Close"]">@Ui.Icon("x")</button>
            </div>

            @* the axes in the corner (drawn by the scripts) *@
            <canvas class="ms-triad" data-triad width="96" height="96" aria-hidden="true"></canvas>

            @* the dialog of the feature being created or edited (filled by the scripts) *@
            <section class="ms-dialog" data-dialog data-collapsible hidden aria-labelledby="ms-dialog-title">
                <header class="ms-dialog__head">
                    <span class="ms-dialog__icon" data-dialog-icon></span>
                    <h2 class="ms-dialog__title" id="ms-dialog-title" data-dialog-title></h2>
                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-dialog-help aria-label="@L["Studio.Help"]" data-tip="@L["Studio.Help"]">@Ui.Icon("help-circle")</button>
                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm ms-dialog__fold" data-fold aria-expanded="true" aria-label="@L["Studio.Fold"]" data-tip="@L["Studio.Fold"]">@Ui.Icon("chevron-up")</button>
                </header>
                <form class="ms-dialog__body mat-form" data-dialog-form novalidate></form>
                <p class="ms-dialog__error" data-dialog-error role="alert" hidden></p>
                <footer class="ms-dialog__foot">
                    <button type="button" class="mat-btn mat-btn--primary mat-btn--sm" data-dialog-ok>@Ui.Icon("check")<span>@L["Studio.Ok"]</span></button>
                    <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-dialog-cancel>@Ui.Icon("x")<span>@L["Common.Cancel"]</span></button>
                </footer>
            </section>

            @* the sketch: one compact line (name, what is in it, finish, cancel); the numbers of the selection open below it; it can be folded away *@
            <section class="ms-dialog ms-dialog--sketch" data-sketch-panel data-collapsible hidden aria-label="@L["Sketch.Properties"]">
                <header class="ms-dialog__head">
                    <span class="ms-dialog__icon">@Ui.Icon("sketch")</span>
                    <div class="ms-dialog__titles">
                        <h2 class="ms-dialog__title" data-sketch-title></h2>
                        <span class="ms-dialog__summary" data-sketch-summary></span>
                    </div>
                    <button type="button" class="mat-btn mat-btn--primary mat-btn--icon mat-btn--sm" data-sketch-action="finish" aria-label="@L["Sketch.Finish"]" data-tip="@L["Sketch.Finish"] (Enter)" data-tip-place="below">@Ui.Icon("check")</button>
                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-sketch-action="cancel" aria-label="@L["Common.Cancel"]" data-tip="@L["Common.Cancel"]" data-tip-place="below">@Ui.Icon("x")</button>
                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm ms-dialog__fold" data-fold aria-expanded="true" aria-label="@L["Studio.Fold"]" data-tip="@L["Studio.Fold"]" data-tip-place="below">@Ui.Icon("chevron-up")</button>
                </header>
                <div class="ms-dialog__body mat-form" data-sketch-body></div>
            </section>

            <div class="ms-hud" data-hud aria-live="polite" hidden></div>
            <div class="ms-measure" data-measure-out aria-live="polite" hidden></div>
            <div class="ms-empty" data-empty hidden>
                @Ui.Icon("cube", "ms-empty__icon")
                <p class="ms-empty__title" data-empty-title></p>
                <p class="ms-empty__text" data-empty-text></p>
            </div>
            <div class="ms-loading" data-loading>
                <span class="mat-spinner" aria-hidden="true"></span>
                <span data-loading-text>@L["Studio.Loading"]</span>
            </div>
            <div class="ms-failure" data-failure hidden role="alert">
                @Ui.Icon("alert")
                <p class="ms-failure__title" data-failure-title></p>
                <p class="ms-failure__text" data-failure-text></p>
                <button type="button" class="mat-btn mat-btn--primary" data-action="reload">@Ui.Icon("refresh")<span>@L["Studio.TryAgain"]</span></button>
            </div>
        </div>
        @if (Model.ShowAi)
            {
                @* the AI assistant: what the person asks becomes features (one step to undo); the server checks every answer *@
                <section class="ms-ai" data-ai-panel hidden aria-labelledby="ms-ai-title">
                    <header class="ms-ai__head">
                        <span class="ms-dialog__icon">@Ui.Icon("sparkles")</span>
                        <h2 class="ms-dialog__title" id="ms-ai-title">@L["Studio.Ai.Title"]</h2>
                        <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-action="ai" aria-label="@L["Common.Dialog.Close"]">@Ui.Icon("x")</button>
                    </header>
                    <ol class="ms-ai__log" data-ai-log aria-live="polite">
                        <li class="ms-ai__hello" data-ai-hello>
                            <p>@L["Studio.Ai.Hello"]</p>
                            <div class="ms-ai__examples">
                                <button type="button" class="mat-chip" data-ai-example>@L["Studio.Ai.Example1"]</button>
                                <button type="button" class="mat-chip" data-ai-example>@L["Studio.Ai.Example2"]</button>
                                <button type="button" class="mat-chip" data-ai-example>@L["Studio.Ai.Example3"]</button>
                            </div>
                        </li>
                    </ol>
                    <footer class="ms-ai__foot">
                        <label class="mat-sr-only" for="ms-ai-input">@L["Studio.Ai.Prompt"]</label>
                        <ul class="ms-ai__files" data-ai-files hidden aria-label="@L["Studio.Ai.Attachments"]"></ul>
                        <textarea class="mat-textarea ms-ai__input" id="ms-ai-input" rows="3" maxlength="4000" placeholder="@L["Studio.Ai.Placeholder"]" data-ai-input></textarea>
                        <div class="ms-ai__send">
                            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-ai-attach aria-label="@L["Studio.Ai.Attach"]" data-tip="@L["Studio.Ai.Attach"]">@Ui.Icon("paperclip")</button>
                            <input type="file" class="mat-sr-only" data-ai-picker multiple accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml,.svg,application/pdf" tabindex="-1" aria-hidden="true">
                            <select class="mat-select mat-select--sm mat-input--sm ms-ai__detail" data-ai-detail aria-label="@L["Studio.Ai.Detail"]" data-tip="@L["Studio.Ai.Detail"]">
                                @foreach (var level in new[] { "rough", "normal", "fine" })
                                {
                                    <option value="@level">@L["Studio.Ai.Detail." + level]</option>
                                }
                            </select>
                            <span class="ms-ai__grow"></span>
                            <button type="button" class="mat-btn mat-btn--primary mat-btn--sm" data-ai-send>@Ui.Icon("sparkles")<span>@L["Studio.Ai.Send"]</span></button>
                        </div>
                        <small class="ms-muted ms-ai__hint">@L["Studio.Ai.Hint"]</small>
                    </footer>
                </section>
            }

    </div>

    <nav class="ms-tabsbar" aria-label="@L["Studio.PartStudios"]">
        <div class="ms-tabsbar__list" role="tablist" data-studio-tabs></div>
        @if (canEdit)
        {
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-menu-toggle="ms-add-menu" aria-haspopup="menu" aria-expanded="false" aria-label="@L["Studio.AddStudio"]" data-tip="@L["Studio.AddStudio"]">@Ui.Icon("plus")</button>
        }
        <span class="ms-tabsbar__grow"></span>
        <span class="ms-tabsbar__status mat-mono" data-status></span>
    </nav>
</div>

@* the keyboard shortcuts (like OnShape), opened with "?" or the help button of the bar *@
<dialog class="mat-dialog" id="ms-keys" aria-labelledby="ms-keys-title">
    <div class="mat-dialog__form">
        <div class="mat-dialog__head">@Ui.Icon("help-circle")<h2 class="mat-dialog__title" id="ms-keys-title">@L["Keys.Title"]</h2>
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="@L["Common.Dialog.Close"]">@Ui.Icon("x")</button></div>
        <div class="mat-dialog__body ms-keys">
            @foreach (var group in KeyMap.Groups)
            {
                <h3>@L["Keys." + group.Name]</h3>
                <dl class="ms-keys__list">
                    @foreach (var k in group.Keys)
                    {
                        <dt>@foreach (var part in k.Keys.Split(" / ")) { <kbd>@part</kbd> }</dt><dd>@L["Keys." + k.Text]</dd>
                    }
                </dl>
            }
        </div>
    </div>
</dialog>

@* picture -> 3D model: the colours of a picture become parts (imagedialog.js) *@
<dialog class="mat-dialog mat-dialog--xl ms-imgdlg" id="ms-image" aria-labelledby="ms-image-title">
    <div class="mat-dialog__form">
        <div class="mat-dialog__head">@Ui.Icon("image")<h2 class="mat-dialog__title" id="ms-image-title">@L["Image.Title"]</h2>
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="@L["Common.Dialog.Close"]">@Ui.Icon("x")</button></div>
        <div class="mat-dialog__body ms-imgdlg__body">
            <div class="ms-imgdlg__view">
                <div class="mat-empty mat-empty--framed ms-imgdlg__drop" data-img-empty>
                    <span class="mat-empty__icon">@Ui.Icon("image")</span>
                    <span class="mat-empty__title">@L["Image.Empty"]</span>
                    <span>@L["Image.EmptyHint"]</span>
                    <button type="button" class="mat-btn mat-btn--primary" data-img-pick>@Ui.Icon("upload")<span>@L["Image.Pick"]</span></button>
                </div>
                <input type="file" class="mat-sr-only" accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml,.svg" data-img-file tabindex="-1" aria-hidden="true">
                <div class="ms-imgdlg__stage" data-img-stage hidden>
                    <canvas class="ms-imgdlg__canvas" data-img-canvas aria-label="@L["Image.Preview"]"></canvas>
                </div>
                <div class="ms-imgdlg__bar" data-img-bar hidden>
                    <div class="mat-seg" role="group" aria-label="@L["Image.Show"]">
                        <button type="button" class="mat-seg__btn" data-img-show="original" aria-pressed="false">@L["Image.Show.Original"]</button>
                        <button type="button" class="mat-seg__btn" data-img-show="colours" aria-pressed="false">@L["Image.Show.Colours"]</button>
                        <button type="button" class="mat-seg__btn" data-img-show="shapes" aria-pressed="true">@L["Image.Show.Shapes"]</button>
                    </div>
                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--sm" data-img-pick>@Ui.Icon("upload")<span>@L["Image.Other"]</span></button>
                </div>
                <p class="ms-muted ms-imgdlg__stats" data-img-stats aria-live="polite"></p>
            </div>
            <div class="ms-imgdlg__side mat-form" data-img-settings>
                <div class="mat-field">
                    <label class="mat-label" for="ms-img-width">@L["Image.Width"]</label>
                    <input class="mat-input mat-input--sm mat-mono" id="ms-img-width" type="number" min="1" max="2000" step="1" value="80" data-img-width>
                </div>
                <div class="mat-field">
                    <label class="mat-label" for="ms-img-colours">@L["Image.Colours"] <output class="mat-mono" data-img-out="colours"></output></label>
                    <input class="mat-range" id="ms-img-colours" type="range" min="2" max="10" step="1" value="6" data-img-colours>
                </div>
                <div class="mat-field">
                    <label class="mat-label" for="ms-img-detail">@L["Image.Detail"]</label>
                    <select class="mat-select mat-select--sm" id="ms-img-detail" data-img-detail>
                        <option value="200">@L["Image.Detail.Coarse"]</option>
                        <option value="360" selected>@L["Image.Detail.Medium"]</option>
                        <option value="600">@L["Image.Detail.Fine"]</option>
                    </select>
                </div>
                <div class="mat-field">
                    <label class="mat-label" for="ms-img-smooth">@L["Image.Smooth"] <output class="mat-mono" data-img-out="smooth"></output></label>
                    <input class="mat-range" id="ms-img-smooth" type="range" min="0" max="4" step="1" value="1" data-img-smooth>
                </div>
                <div class="mat-field">
                    <label class="mat-label" for="ms-img-tol">@L["Image.Tolerance"] <output class="mat-mono" data-img-out="tol"></output></label>
                    <input class="mat-range" id="ms-img-tol" type="range" min="0.5" max="4" step="0.25" value="1" data-img-tol>
                </div>
                <div class="mat-field">
                    <label class="mat-label" for="ms-img-minarea">@L["Image.MinArea"] <output class="mat-mono" data-img-out="minarea"></output></label>
                    <input class="mat-range" id="ms-img-minarea" type="range" min="0" max="400" step="4" value="24" data-img-minarea>
                </div>
                <div class="mat-checks">
                    <label class="mat-check"><input type="checkbox" checked data-img-circles><span class="mat-check__text">@L["Image.Circles"]</span></label>
                    <label class="mat-check"><input type="checkbox" checked data-img-rects><span class="mat-check__text">@L["Image.Rects"]</span></label>
                </div>
                <h3 class="ms-imgdlg__h">@L["Image.Base"]</h3>
                <div class="mat-field">
                    <label class="mat-label" for="ms-img-base">@L["Image.Base.Kind"]</label>
                    <select class="mat-select mat-select--sm" id="ms-img-base" data-img-base>
                        <option value="outline">@L["Image.Base.Outline"]</option>
                        <option value="rect">@L["Image.Base.Rect"]</option>
                        <option value="none">@L["Image.Base.None"]</option>
                    </select>
                </div>
                <div class="ms-imgdlg__row" data-img-base-fields>
                    <div class="mat-field"><label class="mat-label" for="ms-img-baseh">@L["Image.Base.Height"]</label><input class="mat-input mat-input--sm mat-mono" id="ms-img-baseh" type="number" min="0" step="0.2" value="2" data-img-baseh></div>
                    <div class="mat-field"><label class="mat-label" for="ms-img-margin">@L["Image.Base.Margin"]</label><input class="mat-input mat-input--sm mat-mono" id="ms-img-margin" type="number" min="0" step="0.5" value="2" data-img-margin></div>
                    <div class="mat-field"><label class="mat-label" for="ms-img-basecolor">@L["Image.Base.Color"]</label><input class="ms-imgdlg__color" id="ms-img-basecolor" type="color" value="#ffffff" data-img-basecolor></div>
                </div>
                <h3 class="ms-imgdlg__h">@L["Image.Palette"]</h3>
                <p class="mat-hint">@L["Image.PaletteHint"]</p>
                <ul class="ms-imgdlg__palette" data-img-palette></ul>
            </div>
        </div>
        <div class="mat-dialog__foot">
            <div class="mat-btn-row">
                <button type="button" class="mat-btn mat-btn--primary" data-img-apply disabled>@Ui.Icon("check")<span>@L["Image.Apply"]</span></button>
                @if (Model.ShowAi3d)
                {
                    <button type="button" class="mat-btn mat-btn--secondary" data-img-mesh disabled data-tip="@L["Studio.Mesh.FromImageTip"]">@Ui.Icon("ai-3d")<span>@L["Studio.Mesh.FromImage"]</span></button>
                }
                @if (Model.ShowAi)
                {
                    <button type="button" class="mat-btn mat-btn--secondary" data-img-ai disabled>@Ui.Icon("sparkles")<span>@L["Image.ToAi"]</span></button>
                }
                <button type="button" class="mat-btn mat-btn--ghost" data-dialog-close>@L["Common.Cancel"]</button>
            </div>
        </div>
    </div>
</dialog>

@if (Model.ShowAi3d)
{
    @* AI 3D: a picture, up to four views or a text become a figure – through the AI of the installation (a figure of building blocks, in the chat) or through
       Meshy (a mesh, then a solid part here: meshdialog.js, meshgen.js) *@
    <dialog class="mat-dialog mat-dialog--lg ms-meshdlg" id="ms-mesh" aria-labelledby="ms-mesh-title" data-has-meshy="@(Model.ShowMesh ? "1" : "0")" data-has-ai="@(Model.ShowAi ? "1" : "0")">
        <div class="mat-dialog__form">
            <div class="mat-dialog__head">@Ui.Icon("ai-3d")<h2 class="mat-dialog__title" id="ms-mesh-title">@L["Studio.Mesh.Title"]</h2>
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="@L["Common.Dialog.Close"]">@Ui.Icon("x")</button></div>
            <div class="mat-dialog__body ms-meshdlg__body">
                <div class="ms-meshdlg__ask" data-mesh-ask>
                    @if (Model.ShowMesh && Model.ShowAi)
                    {
                        <div class="mat-seg ms-meshdlg__method" role="group" aria-label="@L["Studio.Mesh.Method"]">
                            <button type="button" class="mat-seg__btn" data-mesh-method="blocks" aria-pressed="false">@Ui.Icon("figure")<span>@L["Studio.Mesh.Method.Blocks"]</span></button>
                            <button type="button" class="mat-seg__btn" data-mesh-method="meshy" aria-pressed="false">@Ui.Icon("ai-3d")<span>@L["Studio.Mesh.Method.Meshy"]</span></button>
                        </div>
                    }
                    <p class="mat-hint ms-meshdlg__hint" data-mesh-hint="blocks" hidden>@L["Studio.Mesh.BlocksHint"]</p>
                    <p class="mat-hint ms-meshdlg__hint" data-mesh-hint="meshy" hidden>@L["Studio.Mesh.MeshyHint"]</p>
                    <div class="mat-seg" role="group" aria-label="@L["Studio.Mesh.From"]">
                        <button type="button" class="mat-seg__btn" data-mesh-mode="image" aria-pressed="true">@Ui.Icon("image")<span>@L["Studio.Mesh.FromPicture"]</span></button>
                        <button type="button" class="mat-seg__btn" data-mesh-mode="text" aria-pressed="false">@Ui.Icon("type")<span>@L["Studio.Mesh.FromText"]</span></button>
                    </div>
                    <div class="ms-meshdlg__pane" data-mesh-pane="image">
                        <div class="mat-empty mat-empty--framed ms-meshdlg__drop" data-mesh-drop>
                            <span class="mat-empty__icon">@Ui.Icon("image")</span>
                            <span class="mat-empty__title">@L["Studio.Mesh.Pictures"]</span>
                            <span>@L["Studio.Mesh.PicturesHint"]</span>
                            <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-mesh-pick>@Ui.Icon("upload")<span>@L["Studio.Mesh.Pick"]</span></button>
                        </div>
                        <input type="file" class="mat-sr-only" multiple accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml,.svg" data-mesh-file tabindex="-1" aria-hidden="true">
                        <ul class="ms-meshdlg__pics" data-mesh-pics aria-label="@L["Studio.Mesh.Pictures"]" hidden></ul>
                    </div>
                    <div class="ms-meshdlg__pane" data-mesh-pane="text" hidden>
                        <label class="mat-label" for="ms-mesh-prompt">@L["Studio.Mesh.Prompt"]</label>
                        <textarea class="mat-textarea" id="ms-mesh-prompt" rows="4" maxlength="800" placeholder="@L["Studio.Mesh.PromptPlaceholder"]" data-mesh-prompt></textarea>
                        <div class="ms-meshdlg__examples">
                            <button type="button" class="mat-chip" data-mesh-example>@L["Studio.Mesh.Example1"]</button>
                            <button type="button" class="mat-chip" data-mesh-example>@L["Studio.Mesh.Example2"]</button>
                            <button type="button" class="mat-chip" data-mesh-example>@L["Studio.Mesh.Example3"]</button>
                        </div>
                        <p class="mat-hint">@L["Studio.Mesh.PromptHint"]</p>
                    </div>
                </div>
                <div class="ms-meshdlg__work" data-mesh-work hidden>
                    <div class="ms-meshdlg__stage">
                        <img class="ms-meshdlg__thumb" data-mesh-thumb alt="@L["Studio.Mesh.Preview"]" hidden>
                        <div class="ms-meshdlg__wait" data-mesh-wait>@Ui.Icon("ai-3d")</div>
                    </div>
                    <div class="ms-meshdlg__bar" role="progressbar" aria-label="@L["Studio.Mesh.Progress"]" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-mesh-bar><span data-mesh-fill></span></div>
                    <p class="ms-meshdlg__state" data-mesh-state aria-live="polite"></p>
                </div>
                <div class="ms-meshdlg__settings mat-form">
                    <div class="ms-meshdlg__row">
                        <div class="mat-field">
                            <label class="mat-label" for="ms-mesh-height">@L["Studio.Mesh.Height"] <span class="ms-muted" data-mesh-unit></span></label>
                            <input class="mat-input mat-input--sm mat-mono" id="ms-mesh-height" type="number" min="0.1" step="any" value="50" data-mesh-height>
                        </div>
                        <div class="mat-field" data-meshy-only>
                            <label class="mat-label" for="ms-mesh-turn">@L["Studio.Mesh.Turn"]</label>
                            <select class="mat-select mat-select--sm" id="ms-mesh-turn" data-mesh-turn>
                                <option value="0">0°</option>
                                <option value="90">90°</option>
                                <option value="180">180°</option>
                                <option value="270">270°</option>
                            </select>
                        </div>
                        <div class="mat-field ms-meshdlg__name" data-meshy-only>
                            <label class="mat-label" for="ms-mesh-name">@L["Studio.Mesh.Name"]</label>
                            <input class="mat-input mat-input--sm" id="ms-mesh-name" maxlength="80" autocomplete="off" data-mesh-name>
                        </div>
                        <div class="mat-field" data-meshy-only>
                            <label class="mat-label" for="ms-mesh-color">@L["Studio.Mesh.Color"]</label>
                            <input class="ms-imgdlg__color" id="ms-mesh-color" type="color" value="#3cb764" data-mesh-color>
                        </div>
                    </div>
                    <label class="mat-check" data-meshy-only><input type="checkbox" data-mesh-rebuild><span class="mat-check__text">@L["Studio.Mesh.Rebuild"]</span></label>
                    <p class="mat-hint" data-meshy-only>@L["Studio.Mesh.Costs"]</p>
                </div>
            </div>
            <div class="mat-dialog__foot">
                <div class="mat-btn-row">
                    <button type="button" class="mat-btn mat-btn--primary" data-mesh-start disabled>@Ui.Icon("sparkles")<span>@L["Studio.Mesh.Start"]</span></button>
                    <button type="button" class="mat-btn mat-btn--primary" data-mesh-apply hidden>@Ui.Icon("check")<span>@L["Studio.Mesh.Apply"]</span></button>
                    <button type="button" class="mat-btn mat-btn--secondary" data-mesh-again hidden>@Ui.Icon("refresh")<span>@L["Studio.Mesh.Again"]</span></button>
                    <button type="button" class="mat-btn mat-btn--secondary" data-mesh-cancel hidden>@Ui.Icon("stop")<span>@L["Studio.Mesh.Stop"]</span></button>
                    <button type="button" class="mat-btn mat-btn--ghost" data-dialog-close>@L["Common.Dialog.Close"]</button>
                </div>
            </div>
        </div>
    </dialog>
}

@* the technical drawing of the visible parts: views in first-angle projection, a section, dimensions, a title block; PDF, SVG, DXF *@
<dialog class="mat-dialog mat-dialog--xl ms-drawdlg" id="ms-drawing" aria-labelledby="ms-drawing-title">
    <div class="mat-dialog__form">
        <div class="mat-dialog__head">@Ui.Icon("drawing")<h2 class="mat-dialog__title" id="ms-drawing-title">@L["Drawing.Title"]</h2>
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="@L["Common.Dialog.Close"]">@Ui.Icon("x")</button></div>
        <div class="mat-dialog__body ms-drawdlg__body">
            <div class="ms-drawdlg__view">
                <div class="ms-drawdlg__stage"><img class="ms-drawdlg__sheet" data-draw-preview alt="@L["Drawing.Preview"]" hidden></div>
                <p class="ms-muted ms-drawdlg__stats" data-draw-stats aria-live="polite"></p>
            </div>
            <div class="ms-drawdlg__side mat-form">
                <div class="mat-field">
                    <label class="mat-label" for="ms-draw-name">@L["Drawing.Name"]</label>
                    <input class="mat-input mat-input--sm" id="ms-draw-name" maxlength="80" autocomplete="off" data-draw-name>
                </div>
                <div class="ms-drawdlg__row">
                    <div class="mat-field">
                        <label class="mat-label" for="ms-draw-sheet">@L["Drawing.Sheet"]</label>
                        <select class="mat-select mat-select--sm" id="ms-draw-sheet" data-draw-sheet>
                            <option value="A4">A4</option><option value="A3">A3</option><option value="A2">A2</option><option value="A1">A1</option>
                        </select>
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" for="ms-draw-scale">@L["Drawing.Scale"]</label>
                        <select class="mat-select mat-select--sm" id="ms-draw-scale" data-draw-scale><option value="auto">@L["Drawing.Scale.Auto"]</option></select>
                    </div>
                </div>
                <h3 class="ms-imgdlg__h">@L["Drawing.Views"]</h3>
                <div class="mat-checks">
                    <label class="mat-check"><input type="checkbox" checked data-draw-view="front"><span class="mat-check__text">@L["Drawing.View.Front"]</span></label>
                    <label class="mat-check"><input type="checkbox" checked data-draw-view="top"><span class="mat-check__text">@L["Drawing.View.Top"]</span></label>
                    <label class="mat-check"><input type="checkbox" checked data-draw-view="left"><span class="mat-check__text">@L["Drawing.View.Left"]</span></label>
                    <label class="mat-check"><input type="checkbox" checked data-draw-view="iso"><span class="mat-check__text">@L["Drawing.View.Iso"]</span></label>
                </div>
                <div class="mat-field">
                    <label class="mat-label" for="ms-draw-section">@L["Drawing.Section"]</label>
                    <select class="mat-select mat-select--sm" id="ms-draw-section" data-draw-section>
                        <option value="none">@L["Drawing.Section.None"]</option>
                        <option value="front" selected>@L["Drawing.Section.Front"]</option>
                        <option value="right">@L["Drawing.Section.Right"]</option>
                        <option value="top">@L["Drawing.Section.Top"]</option>
                    </select>
                </div>
                <div class="mat-field" data-draw-offset-field>
                    <label class="mat-label" for="ms-draw-offset">@L["Drawing.Offset"]</label>
                    <input class="mat-input mat-input--sm mat-mono" id="ms-draw-offset" inputmode="decimal" value="0" autocomplete="off" data-draw-offset>
                </div>
                <div class="mat-checks">
                    <label class="mat-check"><input type="checkbox" checked data-draw-hidden><span class="mat-check__text">@L["Drawing.Hidden"]</span></label>
                    <label class="mat-check"><input type="checkbox" checked data-draw-dims><span class="mat-check__text">@L["Drawing.Dims"]</span></label>
                </div>
                <p class="mat-hint">@L["Drawing.Hint"]</p>
            </div>
        </div>
        <div class="mat-dialog__foot">
            <div class="mat-btn-row">
                <button type="button" class="mat-btn mat-btn--primary" data-draw-save="pdf" disabled>@Ui.Icon("download")<span>PDF</span></button>
                <button type="button" class="mat-btn mat-btn--secondary" data-draw-save="svg" disabled>@Ui.Icon("download")<span>SVG</span></button>
                <button type="button" class="mat-btn mat-btn--secondary" data-draw-save="dxf" disabled>@Ui.Icon("download")<span>DXF</span></button>
                @if (canEdit)
                {
                    <button type="button" class="mat-btn mat-btn--secondary" data-draw-tab disabled>@Ui.Icon("drawing")<span>@L["Drawing.AsTab"]</span></button>
                }
                <button type="button" class="mat-btn mat-btn--ghost" data-dialog-close>@L["Common.Dialog.Close"]</button>
            </div>
        </div>
    </div>
</dialog>

@* inserting a part into an assembly: the parts of the Part Studios *@
<dialog class="mat-dialog" id="ms-insert" aria-labelledby="ms-insert-title">
    <div class="mat-dialog__form">
        <div class="mat-dialog__head">@Ui.Icon("plus")<h2 class="mat-dialog__title" id="ms-insert-title">@L["Asm.Insert"]</h2>
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="@L["Common.Dialog.Close"]">@Ui.Icon("x")</button></div>
        <div class="mat-dialog__body"><ul class="ms-asminsert" data-asm-insert-list></ul></div>
    </div>
</dialog>

@* the 3D mouse: connect it (the browser asks once), its speed, and whether the cap moves the model or the camera; kept on this device *@
<div class="mat-menu" id="ms-spacemouse-menu" role="menu" aria-label="@L["View.SpaceMouse"]" hidden>
    <button type="button" class="mat-menu__item" role="menuitem" data-spacemouse="connect">@Ui.Icon("plug")<span>@L["View.SpaceMouse.Connect"]</span></button>
    <button type="button" class="mat-menu__item" role="menuitem" data-spacemouse="disconnect" hidden>@Ui.Icon("x")<span>@L["View.SpaceMouse.Disconnect"]</span></button>
    <div class="mat-menu__sep" role="separator"></div>
    @foreach (var speed in new[] { "slow", "normal", "fast" })
    {
        <button type="button" class="mat-menu__item" role="menuitemradio" aria-checked="false" data-spacemouse-speed="@speed">@Ui.Icon(speed == "slow" ? "minus" : speed == "fast" ? "plus" : "circle")<span>@L["View.SpaceMouse.Speed." + speed]</span>@Ui.Icon("check", "mat-menu__check")</button>
    }
    <div class="mat-menu__sep" role="separator"></div>
    @foreach (var mode in new[] { "object", "camera" })
    {
        <button type="button" class="mat-menu__item" role="menuitemradio" aria-checked="false" data-spacemouse-mode="@mode">@Ui.Icon(mode == "object" ? "cube" : "eye")<span>@L["View.SpaceMouse.Mode." + mode]</span>@Ui.Icon("check", "mat-menu__check")</button>
    }
</div>

@* the colour schemes of the 3D view (stronger lines, other backgrounds), kept on this device *@
<div class="mat-menu" id="ms-theme-menu" role="menu" aria-label="@L["View.Theme"]" hidden>
    @foreach (var theme in new[] { "auto", "contrast", "dark", "blueprint" })
    {
        <button type="button" class="mat-menu__item" role="menuitemradio" aria-checked="false" data-view-theme="@theme">@Ui.Icon(theme switch { "contrast" => "eye", "dark" => "moon", "blueprint" => "grid", _ => "monitor" })<span>@L["View.Theme." + theme]</span>@Ui.Icon("check", "mat-menu__check")</button>
    }
</div>
