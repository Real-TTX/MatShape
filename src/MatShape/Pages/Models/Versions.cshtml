@page "/Models/Versions"
@model MatShape.Pages.Models.VersionsModel
@{
    ViewData["Title"] = Model.ModelName;
    ViewData["PageSub"] = L["Versions.Sub"].Value;
    ViewData["Crumbs"] = new List<(string, string?)> { (L["Models.Title"].Value, "/Models"), (Model.ModelName, null) };
}

@section TopActions {
    <a class="mat-btn mat-btn--secondary mat-btn--icon" href="/Models/Studio/@Model.Id" aria-label="@L["Models.Open"]" data-tip="@L["Models.Open"]">@Ui.Icon("external")</a>
}

<partial name="_ModelTabs" model='(Model.Id, "versions", Model.IsOwner)' />

<div class="mat-list">
    <partial name="_Toolbar" model="Model.Toolbar" />

    @if (Model.Listing.Rows.Count == 0)
    {
        <partial name="_Empty" model="@(new EmptyStateModel("version", L[Model.Toolbar.Total == 0 ? "Versions.Empty.Title" : "Versions.NoMatch"].Value, L[Model.Toolbar.Total == 0 ? "Versions.Empty.Text" : "Lists.ChangeTools"].Value, Model.Toolbar.Total == 0 && Model.CanEdit, Model.CanEdit ? $"/Models/Version?modelId={Model.Id}" : null, L["Versions.New"].Value, Model.Toolbar.UrlReset()))" />
    }
    else
    {
        <ms-table caption="@L["Versions.Title"]">
            <thead>
                <tr>
                    <th scope="col">@L["Versions.Col.Version"]</th>
                    <th scope="col" class="mat-hide-sm">@L["Versions.Col.By"]</th>
                    <th scope="col" class="mat-num mat-hide-sm">@L["Versions.Col.Features"]</th>
                    <th scope="col" class="mat-hide-md">@L["Versions.Col.Created"]</th>
                    <th scope="col"><span class="mat-sr-only">@L["Common.Actions"]</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model.Listing.Rows)
                {
                    <tr>
                        <td data-label="@L["Versions.Col.Version"]">
                            <a class="ms-name" href="/Models/Studio/@Model.Id?version=@v.Id">@Ui.Icon("version")<span>@v.Name</span></a>
                            @if (!string.IsNullOrEmpty(v.Description)) { <small class="ms-muted ms-block-line">@v.Description</small> }
                        </td>
                        <td data-label="@L["Versions.Col.By"]" class="mat-hide-sm">@(v.CreatedBy ?? "–")</td>
                        <td data-label="@L["Versions.Col.Features"]" class="mat-num mat-mono mat-hide-sm">@v.Features</td>
                        <td data-label="@L["Versions.Col.Created"]" class="mat-mono mat-hide-md">@Dates.Stamp(v.CreateDate, Model.Zone)</td>
                        <td class="mat-table__cell-actions">
                            <div class="mat-table__actions">
                                <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Models/Studio/@Model.Id?version=@v.Id" aria-label="@L["Versions.OpenNamed", v.Name]" data-tip="@L["Versions.Open"]">@Ui.Icon("eye")</a>
                                @if (Model.CanEdit)
                                {
                                    <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Models/Version?modelId=@Model.Id&amp;id=@v.Id" aria-label="@L["Common.EditNamed", v.Name]" data-tip="@L["Common.Edit"]">@Ui.Icon("edit")</a>
                                    <form method="post" asp-page-handler="Restore" asp-route-id="@Model.Id" asp-route-versionId="@v.Id">
                                        <button type="submit" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" aria-label="@L["Versions.RestoreNamed", v.Name]" data-tip="@L["Versions.Restore"]"
                                                data-confirm="@L["Versions.RestoreConfirm", v.Name]" data-confirm-ok="@L["Versions.Restore"]">@Ui.Icon("restore")</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </ms-table>
    }

    <partial name="_Pager" model="Model.Pager" />

    @if (Model.CanEdit)
    {
        <div class="mat-actions">
            <a class="mat-btn mat-btn--primary" href="/Models/Version?modelId=@Model.Id">@Ui.Icon("plus")<span>@L["Versions.New"]</span></a>
        </div>
    }
</div>
